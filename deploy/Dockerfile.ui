FROM python:3.12.12-slim@sha256:f3fa41d74a768c2fce8016b98c191ae8c1bacd8f1152870a3f9f87d350920b7c
WORKDIR /app
COPY requirements-dbt.txt requirements-ui.txt requirements-operations.txt ./
RUN pip install --no-cache-dir -r requirements-dbt.txt -r requirements-ui.txt -r requirements-operations.txt Authlib==1.6.5
COPY src ./src
COPY ui ./ui
COPY sql ./sql
COPY deploy/start_ui.py ./deploy/start_ui.py
RUN useradd --uid 1000 --create-home appuser && chown -R appuser:appuser /app
USER appuser
CMD ["python","deploy/start_ui.py"]
